# Required: create a bot with @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=123456789:replace_with_your_bot_token

# Optional PostgreSQL. Leave these commented to use the built-in local H2 database.
# DATABASE_URL=jdbc:postgresql://localhost:5432/youtube
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=change_me

# Optional: comma-separated Telegram numeric IDs. Use /id in the bot.
ADMIN_USER_IDS=1491734372
ALLOWED_USER_IDS=

# PUBLIC lets anyone use the bot with quotas. ALLOWLIST restricts it to the IDs above.
ACCESS_MODE=PUBLIC
DAILY_JOB_LIMIT=20
REQUIRE_TERMS_ACCEPTANCE=true

# Processing limits. These protect a small self-hosted machine.
MAX_CONCURRENT_JOBS=2
MAX_CONCURRENT_INSPECTIONS=4
MAX_QUEUED_JOBS=500
MAX_QUEUED_INSPECTIONS=1000
MAX_VIDEO_DURATION_SECONDS=10800
MAX_PLAYLIST_ITEMS=20
MEDIA_CACHE_RETENTION=PT24H
ARTIFACT_CACHE_RETENTION=PT720H
AI_CACHE_RETENTION=PT168H
CACHE_ENABLED=true
MEDIA_SOCKET_TIMEOUT=PT30S
YT_DLP_CONCURRENT_FRAGMENTS=4
YT_DLP_RETRIES=5

# Standard Telegram Bot API upload ceiling. Raise only when using a local Bot API server.
TELEGRAM_MAX_UPLOAD_BYTES=50000000

# Feature switches
FEATURE_VIDEO_DOWNLOAD=true
FEATURE_AUDIO_DOWNLOAD=true
FEATURE_THUMBNAILS=true
FEATURE_SUBTITLES=true
FEATURE_TRANSCRIPTS=true
FEATURE_CLIPS=true
FEATURE_PLAYLISTS=true
FEATURE_AI_STUDIO=true

# AI Studio works for free with AI_PROVIDER=local. Optional deeper local LLM mode:
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:4b

# Normally leave these unchanged in Docker.
YT_DLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Optional Netscape-format cookie file for YouTube rate-limit / bot-check responses.
# Never commit this file. Example: C:/TubeForgeTools/youtube-cookies.txt
YOUTUBE_COOKIES_FILE=
YOUTUBE_PROXY_URL=
LOG_LEVEL=INFO
